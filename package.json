{
  "name": "lia-pentomino",
  "version": "2.0.0",
  "type": "module",
  "description": "LiaScript template for Pentomino activities on top of lia-coordinate",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "parcel build src/index.ts --dist-dir dist --no-scope-hoist",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/dock.test.mjs tests/hundredChart.test.mjs tests/import.test.mjs tests/pentominoes.test.mjs"
  },
  "devDependencies": {
    "parcel": "^2.16.4",
    "typescript": "^5.8.3"
  },
  "targets": {
    "main": false,
    "default": {
      "distDir": "dist",
      "context": "browser"
    }
  }
}
